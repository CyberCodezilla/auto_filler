{
  "manifest_version": 3,
  "name": "FormFlow — Precision Autofill",
  "version": "1.0.0",
  "description": "Deterministic, zero-hallucination Google Forms autofill engine with fuzzy matching and audit logs.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/forms/*",
    "file://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FormFlow — Precision Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}